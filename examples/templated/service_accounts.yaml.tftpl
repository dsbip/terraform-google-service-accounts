# Rendered by templatefile() in main.tf, once per environment. Until rendered this
# is a Terraform template, not plain YAML: $${name} inserts a value and
# %%{ if } / %%{ for } are template directives (a "~" trims the following newline).
project_id: ${project_id}

service_accounts:
  - account_id: web-${env}
    display_name: Web runtime (${env})
    iam_bindings:
      - role: roles/iam.serviceAccountUser
        members:
          - ref:deployer-${env}
%{ for member in extra_deployers ~}
          - ${member}
%{ endfor ~}
    project_roles:
      - roles/logging.logWriter
      - roles/cloudtrace.agent

  - account_id: deployer-${env}
    display_name: Deployer (${env})
    iam_bindings:
      - role: roles/iam.workloadIdentityUser
        members:
          - principalSet://iam.googleapis.com/projects/${pool_project_number}/locations/global/workloadIdentityPools/github/attribute.repository/${github_repo}
    project_roles:
      - roles/run.developer
%{ if env == "prod" ~}

  # Production only: an emergency account, disabled until needed.
  - account_id: break-glass-${env}
    display_name: Break-glass (${env})
    disabled: true
    deletion_policy: PREVENT
    iam_bindings:
      - role: roles/iam.serviceAccountTokenCreator
        members:
          - group:${oncall_group}
    project_roles:
      - roles/editor
%{ endif ~}
